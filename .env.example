# Copiá este archivo a .env y completá la clave del proveedor que uses.
# openai | gemini
LLM_PROVIDER=openai

OPENAI_API_KEY=tu_clave_de_openai
GOOGLE_API_KEY=tu_clave_de_gemini

# Pinecone Serverless de la pre-entrega 4.
# Si falta o no responde, la búsqueda queda en BM25 sobre data/.
PINECONE_API_KEY=tu_clave_de_pinecone
INDEX_NAME=techcorp-rag-hibrido

# Cola de jobs y checkpoints de LangGraph. Redis 8 o Redis Stack.
REDIS_URL=redis://localhost:6379/0

# phoenix | langsmith | both
OBSERVABILIDAD=phoenix
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT=techcorp-api

# Solo si OBSERVABILIDAD es langsmith o both.
# LANGSMITH_API_KEY=tu_clave_de_langsmith
# LANGSMITH_PROJECT=techcorp-api

# Cuántos grafos corren a la vez dentro del proceso.
WORKER_CONCURRENCY=4
